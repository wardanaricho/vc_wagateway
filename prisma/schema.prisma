// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  username String @unique
  password String
  name     String
  role     String @default("user")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions    WaSession[]
  apiKeys     ApiKey[]
  autoReplies AutoReply[]
  webhooks    Webhook[]
  messages    Message[]

  @@map("users")
}

model WaSession {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  name   String
  phone  String?
  status String  @default("disconnected")
  qr     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authKeys AuthKey[]
  messages Message[]

  @@index([userId])
  @@map("wa_sessions")
}

model AuthKey {
  id        String @id @default(cuid())
  sessionId String @map("session_id")
  keyId     String @map("key_id")
  data      String @db.LongText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId])
  @@map("auth_keys")
}

model ApiKey {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  name     String
  key      String  @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model AutoReply {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  sessionId String? @map("session_id")

  keyword   String
  matchType String  @default("contains") @map("match_type")
  response  String  @db.Text
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auto_replies")
}

model Webhook {
  id     String @id @default(cuid())
  userId String @map("user_id")

  url      String
  events   String  @default("message")
  secret   String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhooks")
}

model Message {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  sessionId String @map("session_id")

  remoteJid String  @map("remote_jid")
  fromMe    Boolean @map("from_me")
  messageId String? @map("message_id")
  type      String
  content   String? @db.Text
  status    String?

  createdAt DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("messages")
}
